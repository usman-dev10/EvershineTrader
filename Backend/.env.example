# Supabase / Postgres (required)
DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

SUPABASE_URL=https://[REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Use a long random secret in production (never the default below)
SUPABASE_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

APP_NAME=Evershine API
# local | production
APP_ENV=local
API_PREFIX=/api/v1
# Comma-separated. Add your deployed frontend origin for production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Must be false when APP_ENV=production
DEMO_AUTH_ENABLED=true
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
